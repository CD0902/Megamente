    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #03050d;
            font-family: 'Rajdhani', sans-serif;
            color: #f4f7ff;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        #game-wrapper {
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        canvas {
            display: block;
            margin: auto;
            box-shadow: 0 0 50px rgba(6, 182, 212, 0.2);
            border-radius: 14px;
        }

        #playerInput {
            position: fixed;
            left: 50%;
            top: 48%;
            transform: translate(-50%, -50%);
            width: min(420px, 85vw);
            padding: 16px 20px;
            border: 2px solid rgba(6, 182, 212, 0.7);
            border-radius: 14px;
            background: rgba(8, 13, 30, 0.96);
            color: #f8fafc;
            font-family: 'Orbitron', sans-serif;
            font-size: 20px;
            text-align: center;
            outline: none;
            z-index: 100;
            box-shadow: 0 0 35px rgba(6, 182, 212, 0.35);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        #playerInput:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 45px rgba(56, 189, 248, 0.6);
        }
    </style>
</head>

<body>

    <!-- =========================================================
     PANTALLA DE CARGA
========================================================= -->
<section id="loading" class="screen active">
    <div class="loading-card">
        <div class="loading-logo">🤖👾</div>
        <div class="loading-kicker">SISTEMA NEURO</div>
        <h1>MEGAMENTE</h1>
        <p>Preparando tu entrenamiento cognitivo...</p>

        <div class="progress">
            <div id="bar" class="bar"></div>
        </div>

        <div class="loading-info">
