                this.gridSize = gridSize;
                const colors = [0x06b6d4, 0xec4899, 0x10b981, 0xf59e0b, 0x8b5cf6, 0x38bdf8, 0xef4444, 0x3b82f6, 0xeab308];
                const freqs = [330, 392, 440, 523, 587, 659, 698, 783, 880];

                const padSize = gridSize === 2 ? 140 : 105;
                const gap = 16;
                const totalWidth = gridSize * padSize + (gridSize - 1) * gap;
                const startX = (GAME_WIDTH - totalWidth) / 2;
                const startY = 180;

                for (let r = 0; r < gridSize; r++) {
                    for (let c = 0; c < gridSize; c++) {
                        const idx = r * gridSize + c;
                        const x = startX + c * (padSize + gap);
                        const y = startY + r * (padSize + gap);

                        const pad = this.add.graphics();
                        pad.fillStyle(0x0f172a, 0.9);
                        pad.fillRoundedRect(x, y, padSize, padSize, 14);
                        pad.lineStyle(3, colors[idx % colors.length], 0.8);
                        pad.strokeRoundedRect(x, y, padSize, padSize, 14);

                        const hit = new Phaser.Geom.Rectangle(x, y, padSize, padSize);
                        pad.setInteractive(hit, Phaser.Geom.Rectangle.Contains);
                        pad.input.cursor = 'pointer';

                        pad.on("pointerdown", () => {
                            if (this.isShowing) return;
                            this.handlePadClick(idx);
                        });

                        this.pads.push({ graphics: pad, color: colors[idx % colors.length], freq: freqs[idx % freqs.length], x, y, padSize });
                    }
                }
            }

            nextRound() {
                this.playerStep = 0;

                if (this.sequence.length >= 4 && this.gridSize === 2) {
                    this.buildGrid(3); // Upgrade to 3x3 for enhanced cognitive challenge!
                }

                const maxIdx = this.gridSize * this.gridSize - 1;
                this.sequence.push(Phaser.Math.Between(0, maxIdx));
                this.playSequence();
            }

            playSequence() {
                this.isShowing = true;
                this.statusText.setText("Observa detenidamente la secuencia...");

                let delay = 0;
                this.sequence.forEach(padIdx => {
                    this.time.delayedCall(delay, () => this.flashPad(padIdx, 380));
                    delay += 650;
                });

                this.time.delayedCall(delay, () => {
                    this.isShowing = false;
                    this.statusText.setText("¡Tu turno! Repite la secuencia.");
                });
            }

            flashPad(idx, duration) {
                const pad = this.pads[idx];
                if (!pad) return;
                soundFX.playTone(pad.freq, duration / 1000);

                pad.graphics.clear();
                pad.graphics.fillStyle(pad.color, 1);
                pad.graphics.fillRoundedRect(pad.x, pad.y, pad.padSize, pad.padSize, 14);

                this.time.delayedCall(duration, () => {
                    pad.graphics.clear();
                    pad.graphics.fillStyle(0x0f172a, 0.9);
                    pad.graphics.fillRoundedRect(pad.x, pad.y, pad.padSize, pad.padSize, 14);
                    pad.graphics.lineStyle(3, pad.color, 0.8);
                    pad.graphics.strokeRoundedRect(pad.x, pad.y, pad.padSize, pad.padSize, 14);
                });
            }

            handlePadClick(idx) {
                this.flashPad(idx, 200);

                if (idx === this.sequence[this.playerStep]) {
                    this.playerStep++;
                    if (this.playerStep >= this.sequence.length) {
                        const pts = this.sequence.length * 150;
                        this.score += pts;
                        this.scoreText.setText(`Puntos: ${this.score}`);
                        soundFX.playSuccess();

                        const activePad = this.pads[idx];
                        createBurstFX(this, activePad.x + activePad.padSize / 2, activePad.y + activePad.padSize / 2, activePad.color);
                        createFloatingText(this, GAME_WIDTH / 2, 140, `+${pts} ¡SECUENCIA PERFECTA!`, "#10b981");

                        this.statusText.setText("¡Excelente! Secuencia completada.");
                        this.time.delayedCall(1000, () => this.nextRound());
                    }
                } else {
                    soundFX.playError();
                    this.statusText.setText("Secuencia incorrecta.");
                    this.time.delayedCall(1000, () => this.finish());
                }
            }

            finish() {
                if (this.score > scores.memoria) scores.memoria = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 220, "🧠 MÓDULO FINALIZADO", { fontFamily: "Orbitron", fontSize: "36px", color: "#3b82f6" }).setOrigin(0.5);
                this.add.text(GAME_WIDTH / 2, 300, `Puntuación Alcanzada: ${this.score} pts`, { fontFamily: "Rajdhani", fontSize: "24px", color: "#ffffff" }).setOrigin(0.5);

                const btnMenu = this.add.text(GAME_WIDTH / 2, 440, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

        class CambioScene extends Phaser.Scene {
            constructor() { super("CambioScene"); }

            create() {
                this.score = 0;
                this.timeLeft = 40;
                this.gameOver = false;
                this.currentRule = "COLOR";
                this.targetValue = "";
                this.objects = [];
                this.consecutiveHits = 0;

                this.add.rectangle(0, 0, GAME_WIDTH, GAME_HEIGHT, 0x03050d).setOrigin(0);
                addExitToMenuButton(this);

                this.add.text(GAME_WIDTH / 2, 35, "🔄 CAMBIO DE REGLA (FLEXIBILIDAD)", {
                    fontFamily: "Orbitron", fontSize: "24px", color: "#f59e0b"
                }).setOrigin(0.5);

                this.ruleBox = this.add.rectangle(GAME_WIDTH / 2, 90, 680, 50, 0x0f172a, 0.9)
                    .setStrokeStyle(2, 0xf59e0b, 0.8);
                this.ruleText = this.add.text(GAME_WIDTH / 2, 90, "REGLA ACTIVA: ?", {
                    fontFamily: "Orbitron", fontSize: "22px", color: "#ffffff"
                }).setOrigin(0.5);

                this.scoreText = this.add.text(35, 40, "Puntos: 0", { fontFamily: "Orbitron", fontSize: "18px", color: "#ffffff" });
                this.timeText = this.add.text(GAME_WIDTH - 35, 40, "40s", { fontFamily: "Orbitron", fontSize: "18px", color: "#ec4899" }).setOrigin(1, 0);

                this.timer = this.time.addEvent({
                    delay: 1000,
                    loop: true,
                    callback: () => {
                        if (this.gameOver) return;
                        this.timeLeft--;
                        this.timeText.setText(`${this.timeLeft}s`);
                        if (this.timeLeft <= 0) this.finish();
                    }
                });

                this.nextRound();
            }

            triggerRuleSwitchBanner() {
                soundFX.playRuleSwitch();
                const banner = this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, 120, 0xf59e0b, 0.95);
                const txt = this.add.text(GAME_WIDTH / 2, GAME_HEIGHT / 2, "⚠️ ¡CAMBIO DE REGLA! ⚠️", {
                    fontFamily: "Orbitron", fontSize: "36px", fontStyle: "bold", color: "#000000"
                }).setOrigin(0.5);

                this.tweens.add({
                    targets: [banner, txt],
                    alpha: 0,
                    duration: 900,
                    delay: 400,
                    onComplete: () => {
                        banner.destroy();
                        txt.destroy();
                    }
                });
            }

            nextRound() {
                if (this.gameOver) return;
                this.objects.forEach(o => o.destroy());
                this.objects = [];

                const previousRule = this.currentRule;
                if (this.consecutiveHits >= 3 || Math.random() < 0.4) {
                    this.currentRule = this.currentRule === "COLOR" ? "SHAPE" : "COLOR";
                    this.consecutiveHits = 0;
                    if (previousRule !== this.currentRule) {
                        this.triggerRuleSwitchBanner();
                    }
                }

                const colors = ["AZUL", "ROJO", "VERDE"];
                const colorHex = { AZUL: "#38bdf8", ROJO: "#ef4444", VERDE: "#10b981" };
                const colorValues = { AZUL: 0x38bdf8, ROJO: 0xef4444, VERDE: 0x10b981 };
                const shapes = ["▲", "■", "★"];

                if (this.currentRule === "COLOR") {
                    this.targetValue = Phaser.Utils.Array.GetRandom(colors);
                    this.ruleText.setText(`REGLA: TOCA FIGURAS DE COLOR ${this.targetValue}`);
                    this.ruleText.setColor(colorHex[this.targetValue]);
                } else {
                    this.targetValue = Phaser.Utils.Array.GetRandom(shapes);
                    this.ruleText.setText(`REGLA: TOCA FIGURAS QUE SEAN ${this.targetValue}`);
                    this.ruleText.setColor("#f59e0b");
                }

                for (let i = 0; i < 12; i++) {
                    const cName = Phaser.Utils.Array.GetRandom(colors);
                    const sChar = Phaser.Utils.Array.GetRandom(shapes);
                    const x = Phaser.Math.Between(140, GAME_WIDTH - 140);
                    const y = Phaser.Math.Between(180, GAME_HEIGHT - 80);

                    const obj = this.add.text(x, y, sChar, {
                        fontSize: "46px", color: colorHex[cName]
                    }).setOrigin(0.5).setInteractive();
                    obj.input.cursor = 'pointer';

                    obj.colorName = cName;
                    obj.shapeChar = sChar;
                    obj.colorHex = colorValues[cName];
                    this.objects.push(obj);

                    obj.on("pointerover", () => {
                        this.tweens.add({ targets: obj, scale: 1.2, duration: 80 });
                    });

                    obj.on("pointerout", () => {
                        this.tweens.add({ targets: obj, scale: 1.0, duration: 80 });
                    });

                    obj.on("pointerdown", () => {
                        const isCorrect = (this.currentRule === "COLOR" && obj.colorName === this.targetValue) ||
                                          (this.currentRule === "SHAPE" && obj.shapeChar === this.targetValue);

                        if (isCorrect) {
                            soundFX.playSuccess();
                            this.score += 120;
                            this.consecutiveHits++;
                            this.scoreText.setText(`Puntos: ${this.score}`);

                            createBurstFX(this, obj.x, obj.y, obj.colorHex);
                            createFloatingText(this, obj.x, obj.y, "+120!", "#10b981");

                            this.nextRound();
                        } else {
                            soundFX.playError();
                            this.consecutiveHits = 0;
                            this.score = Math.max(0, this.score - 60);
                            this.scoreText.setText(`Puntos: ${this.score}`);

                            createBurstFX(this, obj.x, obj.y, 0xef4444);
                            createFloatingText(this, obj.x, obj.y, "-60!", "#ef4444");
                            this.cameras.main.shake(100, 0.006);
                        }
                    });
                }
            }

            finish() {
                this.gameOver = true;
                if (this.timer) this.timer.remove();
                this.objects.forEach(o => o.destroy());

                if (this.score > scores.cambio) scores.cambio = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 200, "🔄 MÓDULO FINALIZADO", { fontFamily: "Orbitron", fontSize: "36px", color: "#f59e0b" }).setOrigin(0.5);
                this.add.text(GAME_WIDTH / 2, 280, `Puntuación Alcanzada: ${this.score} pts`, { fontFamily: "Rajdhani", fontSize: "24px", color: "#ffffff" }).setOrigin(0.5);

                const btnMenu = this.add.text(GAME_WIDTH / 2, 420, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

        class CaosScene extends Phaser.Scene {
            constructor() { super("CaosScene"); }

            create() {
                this.score = 0;
                this.timeLeft = 35;
                this.gameOver = false;
                this.items = [];

                this.add.rectangle(0, 0, GAME_WIDTH, GAME_HEIGHT, 0x03050d).setOrigin(0);
                addExitToMenuButton(this);

                this.add.text(GAME_WIDTH / 2, 35, "🌪️ MODO CAOS (ATENCIÓN Y REACCIÓN)", {
                    fontFamily: "Orbitron", fontSize: "24px", color: "#8b5cf6"
                }).setOrigin(0.5);

                this.add.text(GAME_WIDTH / 2, 75, "🟢 Núcleos (+100) | 💎 Ciber-Diamantes (+250) | ⏱️ Tiempo (+3s) | 💣 Minas (-150)", {
                    fontFamily: "Rajdhani", fontSize: "17px", color: "#cbd5e1"
                }).setOrigin(0.5);

                this.scoreText = this.add.text(35, 40, "Puntos: 0", { fontFamily: "Orbitron", fontSize: "18px", color: "#ffffff" });
                this.timeText = this.add.text(GAME_WIDTH - 35, 40, "35s", { fontFamily: "Orbitron", fontSize: "18px", color: "#ec4899" }).setOrigin(1, 0);

                this.timer = this.time.addEvent({
                    delay: 1000,
                    loop: true,
                    callback: () => {
                        if (this.gameOver) return;
                        this.timeLeft--;
                        this.timeText.setText(`${this.timeLeft}s`);
                        if (this.timeLeft <= 0) this.finish();
                    }
                });

                this.spawnTimer = this.time.addEvent({
                    delay: 450,
                    loop: true,
                    callback: () => this.spawnChaosItem()
                });
            }

            spawnChaosItem() {
                if (this.gameOver) return;

                const rand = Math.random();
                let type = "CORE";
                if (rand < 0.12) type = "TIME";
                else if (rand < 0.28) type = "DIAMOND";
                else if (rand < 0.55) type = "MINE";

                const x = Phaser.Math.Between(100, GAME_WIDTH - 100);
                const y = Phaser.Math.Between(140, GAME_HEIGHT - 80);

                const configMap = {
                    CORE: { emoji: "🟢", color: 0x10b981, pts: 100 },
                    DIAMOND: { emoji: "💎", color: 0x38bdf8, pts: 250 },
                    TIME: { emoji: "⏱️", color: 0xf59e0b, pts: 50 },
                    MINE: { emoji: "💣", color: 0xef4444, pts: -150 }
                };

                const itemData = configMap[type];

                const circle = this.add.circle(x, y, 28, itemData.color, 0.9);
                circle.setStrokeStyle(2, 0xffffff);
                const label = this.add.text(x, y, itemData.emoji, { fontSize: "22px" }).setOrigin(0.5);

                circle.setInteractive();
                circle.input.cursor = 'pointer';

                const tween = this.tweens.add({
                    targets: [circle, label],
                    scale: { from: 1, to: 0 },
                    duration: 1900,
                    onComplete: () => {
                        circle.destroy();
                        label.destroy();
                    }
                });

                circle.on("pointerdown", () => {
                    if (this.gameOver) return;
                    tween.stop();
                    circle.destroy();
                    label.destroy();

                    if (type === "MINE") {
                        soundFX.playError();
                        this.score = Math.max(0, this.score + itemData.pts);
                        createBurstFX(this, x, y, 0xef4444);
                        createFloatingText(this, x, y, "-150 ¡MINA!", "#ef4444");
                        this.cameras.main.shake(120, 0.008);
                    } else if (type === "TIME") {
                        soundFX.playSuccess();
                        this.timeLeft += 3;
                        this.score += itemData.pts;
                        this.timeText.setText(`${this.timeLeft}s`);
                        createBurstFX(this, x, y, 0xf59e0b);
                        createFloatingText(this, x, y, "+3s TIEMPO!", "#f59e0b");
                    } else {
                        soundFX.playSuccess();
                        this.score += itemData.pts;
                        createBurstFX(this, x, y, itemData.color);
                        createFloatingText(this, x, y, `+${itemData.pts}!`, "#10b981");
                    }

                    this.scoreText.setText(`Puntos: ${this.score}`);
                });
            }

            finish() {
                this.gameOver = true;
                if (this.timer) this.timer.remove();
                if (this.spawnTimer) this.spawnTimer.remove();

                if (this.score > scores.caos) scores.caos = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 200, "🌪️ MÓDULO FINALIZADO", { fontFamily: "Orbitron", fontSize: "36px", color: "#8b5cf6" }).setOrigin(0.5);
                this.add.text(GAME_WIDTH / 2, 280, `Puntuación Alcanzada: ${this.score} pts`, { fontFamily: "Rajdhani", fontSize: "24px", color: "#ffffff" }).setOrigin(0.5);

                const btnMenu = this.add.text(GAME_WIDTH / 2, 420, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

        class MegaScene extends Phaser.Scene {
            constructor() { super("MegaScene"); }

            create() {
                this.score = 0;
                this.timeLeft = 50;
                this.gameOver = false;
                this.phase = 1;

                this.add.rectangle(0, 0, GAME_WIDTH, GAME_HEIGHT, 0x03050d).setOrigin(0);
                addExitToMenuButton(this);

                this.titleText = this.add.text(GAME_WIDTH / 2, 35, "💥 MEGA DESAFÍO COGNITIVO (FASE 1)", {
                    fontFamily: "Orbitron", fontSize: "24px", color: "#ec4899"
                }).setOrigin(0.5);

                this.scoreText = this.add.text(35, 40, "Puntos: 0", { fontFamily: "Orbitron", fontSize: "18px", color: "#ffffff" });
                this.timeText = this.add.text(GAME_WIDTH - 35, 40, "50s", { fontFamily: "Orbitron", fontSize: "18px", color: "#ec4899" }).setOrigin(1, 0);

                this.timer = this.time.addEvent({
                    delay: 1000,
                    loop: true,
                    callback: () => {
                        if (this.gameOver) return;
                        this.timeLeft--;
                        this.timeText.setText(`${this.timeLeft}s`);
                        if (this.timeLeft <= 0) this.finish();
                    }
                });

                this.spawnMegaTarget();
            }

            spawnMegaTarget() {
                if (this.gameOver) return;

                const x = Phaser.Math.Between(150, GAME_WIDTH - 150);
                const y = Phaser.Math.Between(180, GAME_HEIGHT - 100);

                const isHazard = Math.random() < 0.25;
                const obj = this.add.text(x, y, isHazard ? "💣" : "💥", { fontSize: "52px" }).setOrigin(0.5).setInteractive();
                obj.input.cursor = 'pointer';

                this.tweens.add({
                    targets: obj,
                    scale: 1.25,
                    duration: 350,
                    yoyo: true,
                    repeat: -1
                });

                obj.on("pointerdown", () => {
                    if (isHazard) {
                        soundFX.playError();
                        this.score = Math.max(0, this.score - 120);
                        createBurstFX(this, x, y, 0xef4444);
                        createFloatingText(this, x, y, "-120 TRAMPA!", "#ef4444");
                        this.cameras.main.shake(120, 0.008);
                    } else {
                        soundFX.playSuccess();
                        this.score += 200;
                        createBurstFX(this, x, y, 0xec4899);
                        createFloatingText(this, x, y, "+200 MEGA!", "#ec4899");

                        if (this.score >= 1200 && this.phase === 1) {
                            this.phase = 2;
                            this.titleText.setText("💥 MEGA DESAFÍO COGNITIVO (FASE 2)");
                            soundFX.playRuleSwitch();
                        }
                    }

                    this.scoreText.setText(`Puntos: ${this.score}`);
                    obj.destroy();
                    this.time.delayedCall(300, () => this.spawnMegaTarget());
                });
            }

            finish() {
                this.gameOver = true;
                if (this.timer) this.timer.remove();

                if (this.score > scores.mega) scores.mega = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 200, "💥 MEGA DESAFÍO COMPLETADO", { fontFamily: "Orbitron", fontSize: "36px", color: "#ec4899" }).setOrigin(0.5);
                this.add.text(GAME_WIDTH / 2, 280, `Puntuación Máxima: ${this.score} pts`, { fontFamily: "Rajdhani", fontSize: "24px", color: "#ffffff" }).setOrigin(0.5);

                const btnMenu = this.add.text(GAME_WIDTH / 2, 420, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

        const config = {
            type: Phaser.AUTO,
            width: GAME_WIDTH,
            height: GAME_HEIGHT,
            parent: "game",
            backgroundColor: "#03050d",
            scale: {
                mode: Phaser.Scale.FIT,
                autoCenter: Phaser.Scale.CENTER_BOTH
            },
            scene: [
                MainScene,
                CazadorScene,
                NoToquesScene,
                MemoriaScene,
                CambioScene,
                CaosScene,
                MegaScene
            ]
        };

        window.onload = function() {
            new Phaser.Game(config);
        };
    </script>

