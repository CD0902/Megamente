        class CazadorScene extends Phaser.Scene {
            constructor() { super("CazadorScene"); }

            create() {
                this.score = 0;
                this.combo = 0;
                this.bestCombo = 0;
                this.correct = 0;
                this.wrong = 0;
                this.round = 0;
                this.timeLeft = 45;
                this.gameOver = false;
                this.objects = [];
                this.targetSymbol = "";

                this.add.rectangle(0, 0, GAME_WIDTH, GAME_HEIGHT, 0x03050d).setOrigin(0);
                addExitToMenuButton(this);

                this.add.text(GAME_WIDTH / 2, 35, "🎯 CAZADOR DE DISTRACCIONES (INTERACTIVO)", {
                    fontFamily: "Orbitron", fontSize: "24px", fontStyle: "bold", color: "#10b981"
                }).setOrigin(0.5);

                this.scoreText = this.add.text(35, 75, "Puntos: 0", { fontFamily: "Orbitron", fontSize: "20px", color: "#38bdf8" });
                this.comboText = this.add.text(35, 105, "Combo: x0", { fontFamily: "Rajdhani", fontSize: "18px", color: "#f59e0b" });
                this.timeText = this.add.text(GAME_WIDTH - 35, 75, "45s", { fontFamily: "Orbitron", fontSize: "20px", color: "#ec4899" }).setOrigin(1, 0);

                this.targetBox = this.add.rectangle(GAME_WIDTH / 2, 130, 240, 50, 0x0f172a, 0.9)
                    .setStrokeStyle(2, 0x10b981, 0.8);
                this.targetText = this.add.text(GAME_WIDTH / 2, 130, "BUSCA: ?", {
                    fontFamily: "Orbitron", fontSize: "26px", fontStyle: "bold", color: "#ffffff"
                }).setOrigin(0.5);

                this.timer = this.time.addEvent({
                    delay: 1000,
                    loop: true,
                    callback: () => {
                        if (this.gameOver) return;
                        this.timeLeft--;
                        this.timeText.setText(`${this.timeLeft}s`);
                        if (this.timeLeft <= 0) this.finish();
                    }
                });

                this.nextRound();
            }

            update() {
                if (this.gameOver) return;
                this.objects.forEach(obj => {
                    obj.x += obj.vx;
                    obj.y += obj.vy;

                    if (obj.x < 60 || obj.x > GAME_WIDTH - 60) obj.vx *= -1;
                    if (obj.y < 190 || obj.y > GAME_HEIGHT - 60) obj.vy *= -1;
                });
            }

            nextRound() {
                if (this.gameOver) return;
                this.round++;
                this.clearObjects();

                const symbols = ["★", "●", "▲", "◆", "■", "✦", "✚", "⬟"];
                this.targetSymbol = Phaser.Utils.Array.GetRandom(symbols);
                this.targetText.setText(`BUSCA: ${this.targetSymbol}`);

                const amount = Math.min(26, 12 + Math.floor(this.round / 2));
                const distractors = symbols.filter(s => s !== this.targetSymbol);

                for (let i = 0; i < amount; i++) {
                    const isTarget = Math.random() < 0.25;
                    const symbol = isTarget ? this.targetSymbol : Phaser.Utils.Array.GetRandom(distractors);
                    const x = Phaser.Math.Between(80, GAME_WIDTH - 80);
                    const y = Phaser.Math.Between(200, GAME_HEIGHT - 70);

                    const speedMult = 0.6 + Math.min(this.combo * 0.1, 1.2);
                    const vx = Phaser.Math.FloatBetween(-1.2, 1.2) * speedMult;
                    const vy = Phaser.Math.FloatBetween(-1.2, 1.2) * speedMult;

                    const obj = this.add.text(x, y, symbol, {
                        fontSize: Phaser.Math.Between(30, 46) + "px",
                        fontStyle: "bold",
                        color: isTarget ? "#ffffff" : "#cbd5e1"
                    }).setOrigin(0.5).setInteractive();
                    obj.input.cursor = 'pointer';

                    obj.symbol = symbol;
                    obj.vx = vx;
                    obj.vy = vy;
                    this.objects.push(obj);

                    obj.on("pointerover", () => {
                        this.tweens.add({ targets: obj, scale: 1.2, duration: 80 });
                    });

                    obj.on("pointerout", () => {
                        this.tweens.add({ targets: obj, scale: 1.0, duration: 80 });
                    });

                    obj.on("pointerdown", () => this.select(obj));
                }
            }

            select(obj) {
                if (obj.symbol === this.targetSymbol) {
                    soundFX.playSuccess();
                    this.correct++;
                    this.combo++;
                    this.bestCombo = Math.max(this.bestCombo, this.combo);
                    const pts = 100 + this.combo * 20;
                    this.score += pts;
                    this.scoreText.setText(`Puntos: ${this.score}`);
                    this.comboText.setText(`Combo: x${this.combo}`);

                    createBurstFX(this, obj.x, obj.y, 0x10b981);
                    createFloatingText(this, obj.x, obj.y, `+${pts} Combo x${this.combo}!`, "#10b981");

                    this.nextRound();
                } else {
                    soundFX.playError();
                    this.wrong++;
                    this.combo = 0;
                    this.comboText.setText(`Combo: x0`);
                    this.score = Math.max(0, this.score - 50);
                    this.scoreText.setText(`Puntos: ${this.score}`);

                    createBurstFX(this, obj.x, obj.y, 0xef4444);
                    createFloatingText(this, obj.x, obj.y, `-50!`, "#ef4444");
                    this.cameras.main.shake(120, 0.007);
                }
            }

            clearObjects() {
                this.objects.forEach(o => o.destroy());
                this.objects = [];
            }

            finish() {
                this.gameOver = true;
                if (this.timer) this.timer.remove();
                this.clearObjects();

                const record = this.score > scores.cazador;
                if (record) scores.cazador = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 180, record ? "🔥 ¡NUEVO RÉCORD!" : "🎯 FIN DE PARTIDA", {
                    fontFamily: "Orbitron", fontSize: "38px", color: "#10b981"
                }).setOrigin(0.5);

                this.add.text(GAME_WIDTH / 2, 270, `Puntos: ${this.score}\nAciertos: ${this.correct} | Errores: ${this.wrong}\nMejor Combo: x${this.bestCombo}`, {
                    fontFamily: "Rajdhani", fontSize: "22px", color: "#f8fafc", align: "center", lineSpacing: 8
                }).setOrigin(0.5);

                const btnAgain = this.add.text(GAME_WIDTH / 2, 450, "REINTENTAR", {
                    fontFamily: "Orbitron", fontSize: "20px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnAgain.input.cursor = 'pointer';

                const btnMenu = this.add.text(GAME_WIDTH / 2, 530, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#94a3b8"
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnAgain.on("pointerdown", () => this.scene.restart());
                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

