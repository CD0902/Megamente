        </div>
    </div>
</section>

<!-- Música de fondo: coloca musica.mpeg junto a este HTML -->
<audio id="bgMusic" loop preload="auto">
    <source src="ept.mpeg" type="audio/mpeg">
</audio>

<style>
    #loading {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        background:
            radial-gradient(circle at 50% 35%, rgba(6,182,212,.12), transparent 35%),
            radial-gradient(circle at 20% 80%, rgba(99,102,241,.10), transparent 30%),
            #03050d;
        opacity: 1;
        visibility: visible;
        transition: opacity .55s ease, visibility .55s ease;
    }

    #loading.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .loading-card {
        width: min(620px, 94vw);
        padding: 42px 34px 30px;
        text-align: center;
        border: 1px solid rgba(6,182,212,.35);
        border-radius: 24px;
        background: rgba(8,13,30,.88);
        box-shadow:
            0 0 35px rgba(6,182,212,.16),
            inset 0 0 30px rgba(6,182,212,.035);
        backdrop-filter: blur(12px);
    }

    .loading-logo {
        font-size: clamp(52px, 8vw, 76px);
        line-height: 1;
        margin-bottom: 18px;
        filter: drop-shadow(0 0 18px rgba(56,189,248,.45));
        animation: loadingFloat 2s ease-in-out infinite;
    }

    .loading-kicker {
        font-family: 'Orbitron', sans-serif;
        color: #38bdf8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 4px;
        margin-bottom: 8px;
    }

    .loading-card h1 {
        margin: 0;
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(34px, 7vw, 58px);
        font-weight: 900;
        color: #f8fafc;
        letter-spacing: 2px;
        text-shadow: 0 0 22px rgba(6,182,212,.35);
    }

    .loading-card p {
        margin: 12px 0 0;
        color: #94a3b8;
        font-size: 17px;
    }

    .progress {
        height: 22px;
        margin: 30px 0 12px;
        background: #111827;
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 999px;
        overflow: hidden;
        box-shadow: inset 0 0 10px rgba(0,0,0,.45);
    }

    .bar {
        height: 100%;
        width: 0%;
        border-radius: inherit;
        background: linear-gradient(90deg, #22c55e, #06b6d4, #6366f1);
        box-shadow: 0 0 18px rgba(6,182,212,.45);
        transition: width .12s linear;
    }

    .loading-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        color: #64748b;
        font-size: 14px;
    }

    #percent {
        font-family: 'Orbitron', sans-serif;
        color: #38bdf8;
        font-size: 24px;
        font-weight: 900;
    }

    #loadingStatus {
        text-align: right;
    }

    .enter-game {
        width: min(360px, 100%);
        margin-top: 28px;
        padding: 14px 22px;
        border: 1px solid rgba(56,189,248,.55);
        border-radius: 14px;
        background: linear-gradient(135deg, #0f172a, #111827);
        color: #38bdf8;
        font-family: 'Orbitron', sans-serif;
        font-size: 17px;
        font-weight: 900;
        letter-spacing: 1px;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .enter-game:not(:disabled):hover {
        transform: translateY(-2px) scale(1.02);
        background: linear-gradient(135deg, #164e63, #172554);
        box-shadow: 0 0 25px rgba(6,182,212,.25);
