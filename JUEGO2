                        this.timeText.setText(`${this.timeLeft}s`);
                        if (this.timeLeft <= 0) this.finish();
                    }
                });

                this.nextRound();
            }

            nextRound() {
                if (this.gameOver) return;
                this.clearObjects();

                const symbols = ["●", "▲", "■", "★"];
                this.allowedTarget = Phaser.Utils.Array.GetRandom(symbols);
                this.infoText.setText(`TOCA SOLO: ${this.allowedTarget}`);

                const count = 12;
                for (let i = 0; i < count; i++) {
                    const isTarget = Math.random() < 0.35;
                    const symbol = isTarget ? this.allowedTarget : Phaser.Utils.Array.GetRandom(symbols.filter(s => s !== this.allowedTarget));
                    const x = Phaser.Math.Between(110, GAME_WIDTH - 110);
                    const y = Phaser.Math.Between(170, GAME_HEIGHT - 80);

                    const ring = this.add.graphics();
                    const obj = this.add.text(x, y, symbol, {
                        fontSize: "44px", color: "#f8fafc"
                    }).setOrigin(0.5).setInteractive();
                    obj.input.cursor = 'pointer';

                    obj.symbol = symbol;
                    obj.isTarget = isTarget;
                    obj.ring = ring;

                    let lifespan = 2200;
                    obj.decayTween = this.tweens.addCounter({
                        from: 0,
                        to: 360,
                        duration: lifespan,
                        onUpdate: (tween) => {
                            if (!ring || !ring.active) return;
                            ring.clear();
                            ring.lineStyle(3, isTarget ? 0x10b981 : 0xef4444, 0.8);
                            ring.beginPath();
                            ring.arc(x, y, 32, Phaser.Math.DegToRad(0), Phaser.Math.DegToRad(tween.getValue()), false);
                            ring.strokePath();
                        },
                        onComplete: () => {
                            if (obj && obj.active) {
                                ring.destroy();
                                obj.destroy();
                            }
                        }
                    });

                    this.objects.push(obj);

                    obj.on("pointerdown", () => {
                        if (obj.symbol === this.allowedTarget) {
                            soundFX.playSuccess();
                            this.score += 100;
                            this.scoreText.setText(`Puntos: ${this.score}`);
                            createBurstFX(this, obj.x, obj.y, 0x10b981);
                            createFloatingText(this, obj.x, obj.y, "+100!", "#10b981");
                            this.nextRound();
                        } else {
                            soundFX.playError();
                            this.score = Math.max(0, this.score - 90);
                            this.scoreText.setText(`Puntos: ${this.score}`);
                            createBurstFX(this, obj.x, obj.y, 0xef4444);
                            createFloatingText(this, obj.x, obj.y, "-90 ¡TRAMPA!", "#ef4444");
                            this.cameras.main.shake(120, 0.008);
                        }
                    });
                }
            }

            clearObjects() {
                this.objects.forEach(o => {
                    if (o.ring) o.ring.destroy();
                    if (o.decayTween) o.decayTween.stop();
                    o.destroy();
                });
                this.objects = [];
            }

            finish() {
                this.gameOver = true;
                if (this.timer) this.timer.remove();
                this.clearObjects();

                if (this.score > scores.notocar) scores.notocar = this.score;
                saveData();

                this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0x03050d, 0.92);
                this.add.text(GAME_WIDTH / 2, 200, "⚡ MÓDULO FINALIZADO", { fontFamily: "Orbitron", fontSize: "36px", color: "#ef4444" }).setOrigin(0.5);
                this.add.text(GAME_WIDTH / 2, 280, `Puntuación Alcanzada: ${this.score} pts`, { fontFamily: "Rajdhani", fontSize: "24px", color: "#ffffff" }).setOrigin(0.5);

                const btnMenu = this.add.text(GAME_WIDTH / 2, 420, "VOLVER AL MENÚ", {
                    fontFamily: "Orbitron", fontSize: "18px", color: "#38bdf8", backgroundColor: "#0f172a", padding: { left: 20, right: 20, top: 10, bottom: 10 }
                }).setOrigin(0.5).setInteractive();
                btnMenu.input.cursor = 'pointer';

                btnMenu.on("pointerdown", () => this.scene.start("MainScene"));
            }
        }

