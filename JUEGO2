</style>

<script>
(() => {
    const loadingScreen = document.getElementById("loading");
    const bar = document.getElementById("bar");
    const percent = document.getElementById("percent");
    const status = document.getElementById("loadingStatus");
    const enterButton = document.getElementById("enterGame");
    const bgMusic = document.getElementById("bgMusic");

    let progress = 0;
    let ready = false;
    let entered = false;

    const messages = [
        "Cargando recursos...",
        "Preparando módulos...",
        "Sincronizando entrenamiento...",
        "Casi listo..."
    ];

    const loading = setInterval(() => {
        progress = Math.min(100, progress + 2);

        bar.style.width = progress + "%";
        percent.textContent = progress + "%";

        const index = Math.min(
            messages.length - 1,
            Math.floor(progress / 25)
        );
        status.textContent = messages[index];

        if (progress >= 100) {
            clearInterval(loading);
            ready = true;
            status.textContent = "Sistema listo.";
            enterButton.disabled = false;
            enterButton.textContent = "🚀 ENTRAR AL JUEGO";
        }
    }, 45);

    async function startMusic() {
        if (!bgMusic) return;

        bgMusic.volume = 0.45;

        try {
            await bgMusic.play();
        } catch (error) {
            console.warn("La música espera una interacción del usuario:", error);
        }
    }

    function enterGame() {
        if (!ready || entered) return;

        entered = true;

        // La pulsación permite que Chrome reproduzca audio con sonido.
        startMusic();

        enterButton.textContent = "CARGANDO...";
        enterButton.disabled = true;

        loadingScreen.classList.add("hidden");
    }

    enterButton.addEventListener("click", enterGame);

    // También permite entrar tocando la pantalla cuando ya terminó.
    loadingScreen.addEventListener("pointerdown", (event) => {
        if (event.target === enterButton) return;
        if (ready) enterGame();
    });

    // Si se vuelve a la pestaña y el navegador pausó el audio, lo reanuda.
    document.addEventListener("visibilitychange", () => {
        if (!document.hidden && entered && bgMusic.paused) {
            startMusic();
        }
    });

    bgMusic.addEventListener("error", () => {
        status.textContent = "Juego listo. Revisa musica.mpeg";
        console.warn("No se encontró musica.mpeg junto al HTML.");
    });
})();
</script>

<div id="game-wrapper">
        <div id="game"></div>
    </div>

    <script>
        class WebSoundSynth {
            constructor() {
                this.ctx = null;
                this.enabled = true;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) this.ctx = new AudioContext();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playPop(freq = 520, duration = 0.06) {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(freq * 0.5, this.ctx.currentTime + duration);

                gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            }

            playSuccess() {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'triangle';
                    osc.frequency.value = freq;

                    gain.gain.setValueAtTime(0.1, now + idx * 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.05 + 0.2);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + idx * 0.05);
                    osc.stop(now + idx * 0.05 + 0.2);
                });
            }

            playError() {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(190, now);
                osc.frequency.setValueAtTime(110, now + 0.12);

                gain.gain.setValueAtTime(0.12, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.25);
            }

            playTone(freq, duration = 0.3) {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sine';
                osc.frequency.value = freq;

                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + duration);
            }

            playRuleSwitch() {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'square';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.25);

                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.25);
            }
        }

        const soundFX = new WebSoundSynth();

        const GAME_WIDTH = 1100;
        const GAME_HEIGHT = 700;


        // BOTÓN FIJO PARA SALIR AL MENÚ DESDE CUALQUIER JUEGO
        function addExitToMenuButton(scene) {
            const btn = scene.add.text(28, 18, "⟵ SALIR AL MENÚ", {
                fontFamily: "Orbitron",
                fontSize: "14px",
                color: "#ffffff",
                backgroundColor: "#0f172a",
                padding: { left: 12, right: 12, top: 8, bottom: 8 }
            }).setOrigin(0, 0).setDepth(1000).setScrollFactor(0).setInteractive({ useHandCursor: true });

            btn.on("pointerover", () => btn.setAlpha(0.8));
            btn.on("pointerout", () => btn.setAlpha(1));
            btn.on("pointerdown", () => {
                if (typeof soundFX !== "undefined" && soundFX.pop) soundFX.pop();
                scene.scene.start("MainScene");
            });

            return btn;
        }

        const PLAYER_KEY = "MEGAMENTE_PLAYER";
        const SCORES_KEY = "MEGAMENTE_SCORES";

        let playerName = localStorage.getItem(PLAYER_KEY) || "";

        let scores = JSON.parse(
            localStorage.getItem(SCORES_KEY) || "null"
        ) || {
            total: 0,
            cazador: 0,
            notocar: 0,
            memoria: 0,
            cambio: 0,
            caos: 0,
            mega: 0
        };

        function saveData() {
            scores.total =
                scores.cazador +
                scores.notocar +
                scores.memoria +
                scores.cambio +
                scores.caos +
                scores.mega;

            localStorage.setItem(PLAYER_KEY, playerName);
            localStorage.setItem(SCORES_KEY, JSON.stringify(scores));
        }

        function getPlayerRank() {
            const total = scores.total;
            if (total >= 10000) return "🧠 SUPREMO NEURO-MASTER";
            if (total >= 5000) return "⚡ MAESTRO DEL ENFOQUE";
            if (total >= 2500) return "🎯 GUERRERO DE ATENCIÓN";
            if (total >= 1000) return "🚀 EXPLORADOR COGNITIVO";
            return "🌱 APRENDIZ DE FOCO";
        }

        function createBurstFX(scene, x, y, color = 0x38bdf8) {
            for (let i = 0; i < 14; i++) {
                const p = scene.add.circle(x, y, Phaser.Math.Between(3, 7), color, 0.9);
                const angle = Phaser.Math.FloatBetween(0, Math.PI * 2);
                const speed = Phaser.Math.Between(60, 220);

                scene.tweens.add({
                    targets: p,
                    x: x + Math.cos(angle) * speed,
                    y: y + Math.sin(angle) * speed,
                    alpha: 0,
                    scale: 0.2,
                    duration: Phaser.Math.Between(350, 650),
                    ease: "Power2",
                    onComplete: () => p.destroy()
                });
            }
        }

        function createFloatingText(scene, x, y, text, color = "#10b981") {
            const floatTxt = scene.add.text(x, y, text, {
                fontFamily: "Orbitron",
                fontSize: "20px",
                fontStyle: "bold",
                color: color,
                stroke: "#000000",
                strokeThickness: 4
            }).setOrigin(0.5);

            scene.tweens.add({
                targets: floatTxt,
                y: y - 45,
                alpha: 0,
                duration: 750,
                ease: "Cubic.out",
                onComplete: () => floatTxt.destroy()
            });
        }

        class MainScene extends Phaser.Scene {
            constructor() {
                super("MainScene");
            }

            create() {
                this.screenObjects = [];
                this.navLock = false;

                this.bg = this.add.container(0, 0);
                this.ui = this.add.container(0, 0);

                this.createAtmosphere();

                if (playerName) {
                    this.showMainMenu();
                } else {
                    this.showPlayerRegistration();
                }
            }

            addUI(object) {
                this.ui.add(object);
                this.screenObjects.push(object);
                return object;
            }

            clearScreen() {
                const input = document.getElementById("playerInput");
                if (input) input.remove();

                this.screenObjects.forEach(object => {
                    if (object && object.destroy) object.destroy();
                });

                this.screenObjects = [];
                this.navLock = false;
            }

            createAtmosphere() {
                const background = this.add.graphics();
                background.fillGradientStyle(0x050713, 0x080d20, 0x03050d, 0x070b18, 1);
                background.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);
                this.bg.add(background);

                const lights = [
                    { x: 180, y: 130, radius: 240, alpha: 0.08 },
                    { x: 880, y: 180, radius: 290, alpha: 0.07 },
                    { x: 550, y: 640, radius: 310, alpha: 0.05 }
                ];

                lights.forEach((light, index) => {
                    const circle = this.add.circle(light.x, light.y, light.radius, 0x06b6d4, light.alpha);
                    this.bg.add(circle);

                    this.tweens.add({
                        targets: circle,
                        x: light.x + (index % 2 ? 35 : -25),
                        y: light.y + (index % 2 ? -25 : 30),
                        scale: 1.12,
                        duration: 6500 + index * 900,
                        yoyo: true,
                        repeat: -1,
                        ease: "Sine.easeInOut"
                    });
                });

                const grid = this.add.graphics();
                grid.lineStyle(1, 0x06b6d4, 0.04);
                for (let x = 0; x <= GAME_WIDTH; x += 50) grid.lineBetween(x, 0, x, GAME_HEIGHT);
                for (let y = 0; y <= GAME_HEIGHT; y += 50) grid.lineBetween(0, y, GAME_WIDTH, y);
                this.bg.add(grid);

                for (let i = 0; i < 45; i++) {
                    const particle = this.add.circle(
                        Phaser.Math.Between(15, GAME_WIDTH - 15),
                        Phaser.Math.Between(15, GAME_HEIGHT - 15),
                        Phaser.Math.Between(1.5, 3),
                        0x38bdf8,
                        Phaser.Math.FloatBetween(0.12, 0.38)
                    );
                    this.bg.add(particle);

                    this.tweens.add({
                        targets: particle,
                        y: particle.y - Phaser.Math.Between(20, 90),
                        alpha: Phaser.Math.FloatBetween(0.05, 0.35),
                        duration: Phaser.Math.Between(2500, 6000),
                        yoyo: true,
                        repeat: -1,
                        ease: "Sine.easeInOut"
                    });
                }
            }

            title(text, y = 95, size = 52) {
                const title = this.addUI(
                    this.add.text(GAME_WIDTH / 2, y, text, {
                        fontFamily: "Orbitron, Arial Black",
                        fontSize: size + "px",
                        color: "#06b6d4",
                        fontStyle: "bold",
                        stroke: "#020617",
                        strokeThickness: 8
                    }).setOrigin(0.5)
                );

                this.tweens.add({
                    targets: title,
                    alpha: 0.92,
                    scale: 1.015,
                    duration: 1800,
                    yoyo: true,
                    repeat: -1,
                    ease: "Sine.easeInOut"
                });

                return title;
            }

            createButton(x, y, text, callback, width = 360) {
                const box = this.addUI(
                    this.add.rectangle(x, y, width, 56, 0x0f172a, 0.9)
                        .setStrokeStyle(2, 0x06b6d4, 0.4)
                        .setOrigin(0.5)
                        .setInteractive()
                );
                box.input.cursor = 'pointer';

                const label = this.addUI(
                    this.add.text(x, y, text, {
                        fontFamily: "Orbitron, Rajdhani",
                        fontSize: "20px",
                        color: "#38bdf8",
                        fontStyle: "bold"
                    }).setOrigin(0.5)
                );

                box.on("pointerover", () => {
                    if (this.navLock) return;
                    soundFX.playPop(600, 0.04);
                    box.setFillStyle(0x1e293b, 0.95);
                    box.setStrokeStyle(2, 0x38bdf8, 0.9);
                    label.setColor("#ffffff");
                    this.tweens.add({ targets: [box, label], scale: 1.03, duration: 100 });
                });

                box.on("pointerout", () => {
                    box.setFillStyle(0x0f172a, 0.9);
                    box.setStrokeStyle(2, 0x06b6d4, 0.4);
                    label.setColor("#38bdf8");
                    this.tweens.add({ targets: [box, label], scale: 1, duration: 100 });
                });

                box.on("pointerdown", (pointer, localX, localY, event) => {
                    if (event) event.stopPropagation();
                    if (this.navLock) return;
                    this.navLock = true;
                    soundFX.playPop(450, 0.05);
                    callback();
                });

                return { box, label };
            }

            showPlayerRegistration() {
                this.clearScreen();

                this.addUI(
                    this.add.rectangle(GAME_WIDTH / 2, 350, 580, 420, 0x0f172a, 0.92)
                        .setStrokeStyle(2, 0x06b6d4, 0.4)
                );

                this.title("🧠 MEGAMENTE", 105, 54);

                this.addUI(
                    this.add.text(GAME_WIDTH / 2, 190, "REGISTRO DE AGENTE NEURO", {
                        fontFamily: "Orbitron",
                        fontSize: "22px",
                        fontStyle: "bold",
                        color: "#38bdf8"
                    }).setOrigin(0.5)
                );

                this.addUI(
                    this.add.text(GAME_WIDTH / 2, 230, "Ingresa tu nombre para iniciar el entrenamiento cognitivo:", {
                        fontSize: "17px",
                        color: "#94a3b8"
                    }).setOrigin(0.5)
                );

                const input = document.createElement("input");
                input.id = "playerInput";
                input.type = "text";
                input.maxLength = 16;
                input.placeholder = "Nombre o Apodo...";
                input.value = playerName;
                document.body.appendChild(input);

                const button = this.createButton(GAME_WIDTH / 2, 445, "🚀 INICIAR AVENTURA", () => {
                    const value = input.value.trim();
                    if (!value) {
                        input.style.borderColor = "#ef4444";
                        input.placeholder = "¡Escribe un nombre primero!";
                        soundFX.playError();
                        this.navLock = false;
                        return;
                    }

                    playerName = value.toUpperCase();
                    saveData();
                    soundFX.playSuccess();
                    input.remove();
                    this.showMainMenu();
